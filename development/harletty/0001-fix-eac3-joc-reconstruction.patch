@@ -0,0 +1,145 @@
+//! Summarize JOC coding modes used by a raw E-AC-3 elementary stream.
+//!
+//! `cargo run -p eac3 --example joc_scan -- <input.eb3>`
+
+use std::{collections::BTreeMap, fs, path::PathBuf};
+
+use eac3::{Extractor, ParsedEmdfPayloadData, inspect_access_unit};
+
+fn main() {
+    let input = std::env::args_os()
+        .nth(1)
+        .map(PathBuf::from)
+        .expect("usage: joc_scan <input.eb3>");
+    let bytes = fs::read(&input).expect("read input");
+    let mut extractor = Extractor::default();
+    extractor.push_bytes(&bytes);
+
+    let mut frames = 0usize;
+    let mut legacy_frames = 0usize;
+    let mut joc_frames = 0usize;
+    let mut active_objects = 0usize;
+    let mut sparse_objects = 0usize;
+    let mut steep_objects = 0usize;
+    let mut sparse_and_steep_objects = 0usize;
+    let mut one_point_objects = 0usize;
+    let mut two_point_objects = 0usize;
+    let mut bands_histogram = [0usize; 24];
+    let mut joc_shapes = BTreeMap::new();
+    let mut frame_shapes = BTreeMap::new();
+    let mut oamd_shapes = BTreeMap::new();
+    let mut bed_assignments = BTreeMap::new();
+    let mut oamd_payloads = 0usize;
+    let mut oamd_object_elements = 0usize;
+    let mut oamd_object_blocks = 0usize;
+    let mut parse_errors = 0usize;
+
+    while let Some(frame) = extractor.next_frame().expect("extract frame") {
+        frames += 1;
+        if frame.info().bitstream_id <= 10 {
+            legacy_frames += 1;
+            continue;
+        }
+        let info = match inspect_access_unit(frame.as_bytes()) {
+            Ok(info) => info,
+            Err(error) => {
+                parse_errors += 1;
+                eprintln!("frame {frames}: {error}");
+                continue;
+            }
+        };
+        *frame_shapes
+            .entry((
+                format!("{:?}", info.frame_type),
+                info.channel_mode,
+                info.fullband_channels,
+                info.lfe_on,
+                info.dependent_channel_map,
+            ))
+            .or_insert(0usize) += 1;
+        for payload in info.payloads() {
+            match &payload.parsed {
+                ParsedEmdfPayloadData::Joc(joc) => {
+                    joc_frames += 1;
+                    *joc_shapes
+                        .entry((joc.channel_count, joc.object_count))
+                        .or_insert(0usize) += 1;
+                    for object in &joc.objects {
+                        if !object.active {
+                            continue;
+                        }
+                        active_objects += 1;
+                        sparse_objects += usize::from(object.sparse_coded);
+                        steep_objects += usize::from(object.steep_slope);
+                        sparse_and_steep_objects +=
+                            usize::from(object.sparse_coded && object.steep_slope);
+                        one_point_objects += usize::from(object.data_points == 1);
+                        two_point_objects += usize::from(object.data_points == 2);
+                        if object.bands < bands_histogram.len() {
+                            bands_histogram[object.bands] += 1;
+                        }
+                    }
+                }
+                ParsedEmdfPayloadData::Oamd(oamd) => {
+                    oamd_payloads += 1;
+                    *oamd_shapes
+                        .entry((
+                            oamd.object_count,
+                            oamd.beds,
+                            oamd.bed_or_isf_objects,
+                            oamd.dynamic_objects,
+                            oamd.isf_index,
+                        ))
+                        .or_insert(0usize) += 1;
+                    *bed_assignments
+                        .entry(format!("{:?}", oamd.bed_assignment))
+                        .or_insert(0usize) += 1;
+                    for element in &oamd.elements {
+                        if let eac3::OamdElementKind::Object(object) = &element.kind {
+                            oamd_object_elements += 1;
+                            oamd_object_blocks +=
+                                object.object_blocks.iter().map(Vec::len).sum::<usize>();
+                        }
+                    }
+                }
+                ParsedEmdfPayloadData::Unknown => {}
+            }
+        }
+    }
+
+    println!("input={}", input.display());
+    println!("frames={frames}");
+    println!("legacy_frames={legacy_frames}");
+    println!("joc_frames={joc_frames}");
+    for ((frame_type, acmod, channels, lfe, chanmap), count) in frame_shapes {
+        println!(
+            "frame_type={frame_type} acmod={acmod} fullband_channels={channels} lfe={lfe} chanmap={chanmap:?} frames={count}"
+        );
+    }
+    for ((channels, objects), count) in joc_shapes {
+        println!("joc_channels={channels} objects={objects} payloads={count}");
+    }
+    println!("oamd_payloads={oamd_payloads}");
+    for ((objects, beds, bed_or_isf, dynamic, isf_index), count) in oamd_shapes {
+        println!(
+            "oamd_objects={objects} beds={beds} bed_or_isf={bed_or_isf} dynamic={dynamic} isf_index={isf_index:?} payloads={count}"
+        );
+    }
+    for (assignment, count) in bed_assignments {
+        println!("oamd_bed_assignment={assignment} payloads={count}");
+    }
+    println!("oamd_object_elements={oamd_object_elements}");
+    println!("oamd_object_blocks={oamd_object_blocks}");
+    println!("active_objects={active_objects}");
+    println!("sparse_objects={sparse_objects}");
+    println!("steep_objects={steep_objects}");
+    println!("sparse_and_steep_objects={sparse_and_steep_objects}");
+    println!("one_point_objects={one_point_objects}");
+    println!("two_point_objects={two_point_objects}");
+    for (bands, count) in bands_histogram.into_iter().enumerate() {
+        if count != 0 {
+            println!("objects_with_{bands}_bands={count}");
+        }
+    }
+    println!("parse_errors={parse_errors}");
+}
