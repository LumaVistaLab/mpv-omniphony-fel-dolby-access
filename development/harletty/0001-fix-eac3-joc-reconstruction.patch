+            timeslot_offsets,
+            &object,
+            4,
+            &mut output,
+        )
+        .expect("timeslots");
+
+        for (timeslot, multiplier) in [0.5, 1.0, 1.5, 2.0].into_iter().enumerate() {
+            assert!(
+                output[timeslot][0]
+                    .iter()
+                    .all(|value| (*value - multiplier * COARSE_STEP).abs() < 1e-6)
+            );
+        }
+    }
+
+    #[test]
+    fn bypassed_lfe_is_delayed_to_match_qmf_objects() {
+        let mut state = JocObjectDecoderState::default();
+        let mut first = vec![1.0; 1536];
+        state.align_bypassed_lfe(Some(&mut first));
+        assert!(
+            first[..JOC_QMF_DELAY_SAMPLES]
+                .iter()
+                .all(|sample| *sample == 0.0)
+        );
+        assert!(
+            first[JOC_QMF_DELAY_SAMPLES..]
+                .iter()
+                .all(|sample| *sample == 1.0)
+        );
+
+        let mut second = vec![2.0; 1536];
+        state.align_bypassed_lfe(Some(&mut second));
+        assert!(
+            second[..JOC_QMF_DELAY_SAMPLES]
+                .iter()
+                .all(|sample| *sample == 1.0)
+        );
+        assert!(
+            second[JOC_QMF_DELAY_SAMPLES..]
+                .iter()
+                .all(|sample| *sample == 2.0)
+        );
+    }
 }
