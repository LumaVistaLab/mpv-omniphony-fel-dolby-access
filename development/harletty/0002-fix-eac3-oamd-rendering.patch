+fn parse_oamd_trim_element(
+    reader: &mut BitReader<'_>,
+    object_count: usize,
+) -> Result<OamdTrimElement, ParseError> {
+    const TRIM_DB: [f32; 16] = [
+        6.0, 3.0, 1.5, 0.75, -0.75, -1.5, -3.0, -4.5, -6.0, -7.5, -9.0, -10.5, -12.0, -13.5, -16.0,
+        -36.0,
+    ];
+
+    let warp_mode = read_bits(reader, 2, "warp_mode")? as u8;
+    let reserved = read_bits(reader, 2, "trim_reserved")? as u8;
+    let global_trim_mode = read_bits(reader, 2, "global_trim_mode")? as u8;
+    let mut trims = [None; OAMD_TRIM_CONFIGS];
+
+    if global_trim_mode == 2 {
+        for trim in &mut trims {
+            let default_trim = read_bit(reader, "b_default_trim")?;
+            let mut decoded = OamdTrim {
+                default_trim,
+                disable_trim: false,
+                centre_db: None,
+                surround_db: None,
+                height_db: None,
+                balance_y_top_bottom: None,
+                balance_y_listener: None,
+            };
+            if !default_trim {
+                decoded.disable_trim = read_bit(reader, "b_disable_trim")?;
+                if !decoded.disable_trim {
+                    let presence = read_bits(reader, 5, "trim_balance_presence")? as u8;
+                    if (presence & 0x10) != 0 {
+                        decoded.centre_db =
+                            Some(TRIM_DB[read_bits(reader, 4, "trim_centre")? as usize]);
+                    }
+                    if (presence & 0x08) != 0 {
+                        decoded.surround_db =
+                            Some(TRIM_DB[read_bits(reader, 4, "trim_surround")? as usize]);
+                    }
+                    if (presence & 0x04) != 0 {
+                        decoded.height_db =
+                            Some(TRIM_DB[read_bits(reader, 4, "trim_height")? as usize]);
+                    }
+                    if (presence & 0x02) != 0 {
+                        let sign = if read_bit(reader, "balance_y_tb_sign")? {
+                            1.0
+                        } else {
+                            -1.0
+                        };
+                        decoded.balance_y_top_bottom = Some(
+                            (read_bits(reader, 4, "balance_y_tb_amount")? as f32 + 1.0)
+                                * (sign / 16.0),
+                        );
+                    }
+                    if (presence & 0x01) != 0 {
+                        let sign = if read_bit(reader, "balance_y_listener_sign")? {
+                            1.0
+                        } else {
+                            -1.0
+                        };
+                        decoded.balance_y_listener = Some(
+                            (read_bits(reader, 4, "balance_y_listener_amount")? as f32 + 1.0)
+                                * (sign / 16.0),
+                        );
+                    }
+                }
+            }
+            *trim = Some(decoded);
+        }
+    }
+
+    let mut disable_trim_per_object = Vec::new();
+    if read_bit(reader, "b_disable_trim_per_obj")? {
+        disable_trim_per_object.reserve(object_count);
+        for _ in 0..object_count {
+            disable_trim_per_object.push(read_bit(reader, "b_disable_trim")?);
+        }
+    }
+
+    Ok(OamdTrimElement {
+        warp_mode,
+        reserved,
+        global_trim_mode,
+        trims,
+        disable_trim_per_object,
+    })
+}
