+        let mut payload = payload_with_object_blocks(vec![vec![first, delta]]);
+        MetadataParseState::default()
+            .oamd
+            .resolve_payload(&mut payload);
+
+        let resolved = second_block(&payload);
+        let position = resolved.position.expect("resolved position");
+        assert!((position.x - (0.5 + 2.0 * XY_SCALE)).abs() < 1e-6);
+        assert!((position.y - (0.5 - 3.0 * XY_SCALE)).abs() < 1e-6);
+        assert!((position.z - Z_SCALE).abs() < 1e-6);
+        assert!(!resolved.differential_position);
+    }
+
+    #[test]
+    fn gain_index_three_reuses_previous_object_in_same_update() {
+        let first = OamdObjectBlock {
+            basic_info_status: 1,
+            basic_info_blocks: Some(3),
+            gain: Some(-9),
+            priority: Some(32),
+            render_info_status: 0,
+            ..OamdObjectBlock::default()
+        };
+        let second = OamdObjectBlock {
+            basic_info_status: 1,
+            basic_info_blocks: Some(3),
+            gain_from_previous_object: true,
+            priority: Some(32),
+            render_info_status: 0,
+            ..OamdObjectBlock::default()
+        };
+        let mut payload = payload_with_object_blocks(vec![vec![first], vec![second]]);
+        MetadataParseState::default()
+            .oamd
+            .resolve_payload(&mut payload);
+        let OamdElementKind::Object(object) = &payload.elements[0].kind else {
+            panic!("expected object element");
+        };
+        assert_eq!(object.object_blocks[0][0].gain, Some(-9));
+        assert_eq!(object.object_blocks[1][0].gain, Some(-9));
+    }
+
+    #[test]
+    fn status_zero_restores_normative_defaults() {
+        let mut payload = payload_with_object_blocks(vec![vec![
+            full_update(
+                Vec3 {
+                    x: 0.25,
+                    y: 0.75,
+                    z: 0.5,
+                },
+                -3,
+                10,
+                [0.5; 3],
+                0.5,
+                0.5,
+                2.0,
+            ),
+            OamdObjectBlock::default(),
+        ]]);
+        MetadataParseState::default()
+            .oamd
+            .resolve_payload(&mut payload);
+        let resolved = second_block(&payload);
+        assert_eq!(resolved.gain, Some(-128));
+        assert_eq!(resolved.priority, Some(0));
+        assert_eq!(resolved.anchor, ObjectAnchor::Room);
+        assert_eq!(
+            resolved.position,
+            Some(Vec3 {
+                x: 0.5,
+                y: 0.5,
+                z: 0.0
+            })
+        );
+        assert_eq!(resolved.size, Some([0.0; 3]));
+    }
 }
