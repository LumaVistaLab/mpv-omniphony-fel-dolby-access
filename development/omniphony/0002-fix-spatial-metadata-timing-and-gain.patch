+
+    /// Render one decoded frame while applying spatial metadata at its exact
+    /// sample boundary. `SpatialRenderer::render_frame` applies all supplied
+    /// events before the whole block, so a frame containing multiple OAMD
+    /// updates has to be split here. Events at or beyond the frame end remain
+    /// queued for the next decoded frame.
+    fn render_scheduled_pcm(
+        &mut self,
+        pcm: &[f32],
+        channel_count: usize,
+        frame_start: u64,
+        sample_count: usize,
+        measure_breakdown: bool,
+    ) -> Result<RenderedFrame> {
+        let due = take_due_events(&mut self.frame_events, frame_start, sample_count);
+
+        let mut output =
+            Vec::with_capacity(sample_count.saturating_mul(self.renderer.output_channel_count()));
+        let mut final_object_gains = Vec::new();
+        let mut final_object_band_gains = Vec::new();
+        let mut crossover_time_ms = 0.0;
+
+        let mut cursor = 0usize;
+        let mut current_event_start = 0usize;
+        let mut current_event_end = 0usize;
+        let mut event_index = 0usize;
+
+        while event_index < due.len() {
+            let event_offset = due[event_index]
+                .sample_pos
+                .unwrap_or(frame_start)
+                .saturating_sub(frame_start)
+                .min(sample_count as u64) as usize;
+
+            if event_offset > cursor {
+                let rendered = self.renderer.render_frame(
+                    &pcm[cursor * channel_count..event_offset * channel_count],
+                    channel_count,
+                    &due[current_event_start..current_event_end],
+                    Vec::new(),
+                    measure_breakdown,
+                )?;
+                output.extend_from_slice(&rendered.samples);
+                final_object_gains = rendered.object_gains;
+                final_object_band_gains = rendered.object_band_gains;
+                crossover_time_ms += rendered.crossover_time_ms;
+                cursor = event_offset;
+            }
+
+            current_event_start = event_index;
+            event_index += 1;
+            while event_index < due.len() {
+                let next_offset = due[event_index]
+                    .sample_pos
+                    .unwrap_or(frame_start)
+                    .saturating_sub(frame_start)
+                    .min(sample_count as u64) as usize;
+                if next_offset != event_offset {
+                    break;
+                }
+                event_index += 1;
+            }
+            current_event_end = event_index;
+        }
+
+        if cursor < sample_count {
+            let rendered = self.renderer.render_frame(
+                &pcm[cursor * channel_count..sample_count * channel_count],
+                channel_count,
+                &due[current_event_start..current_event_end],
+                Vec::new(),
+                measure_breakdown,
+            )?;
+            output.extend_from_slice(&rendered.samples);
+            final_object_gains = rendered.object_gains;
+            final_object_band_gains = rendered.object_band_gains;
+            crossover_time_ms += rendered.crossover_time_ms;
+        }
+
+        Ok(RenderedFrame {
+            samples: output,
+            object_gains: final_object_gains,
+            object_band_gains: final_object_band_gains,
+            crossover_time_ms,
+        })
+    }
+}
+
+fn take_due_events(
+    events: &mut Vec<SpatialChannelEvent>,
+    frame_start: u64,
+    sample_count: usize,
+) -> Vec<SpatialChannelEvent> {
+    events.sort_by_key(|event| event.sample_pos.unwrap_or(frame_start));
+    let frame_end = frame_start.saturating_add(sample_count as u64);
+    let due_count =
+        events.partition_point(|event| event.sample_pos.unwrap_or(frame_start) < frame_end);
+    let future = events.split_off(due_count);
+    std::mem::replace(events, future)
+}
