+
+    #[test]
+    fn due_events_are_sorted_and_future_events_survive() {
+        let mut events = vec![
+            event(3, Some(110)),
+            event(2, Some(109)),
+            event(0, None),
+            event(1, Some(100)),
+        ];
+        let due = take_due_events(&mut events, 100, 10);
+        assert_eq!(
+            due.iter()
+                .map(|event| event.channel_idx)
+                .collect::<Vec<_>>(),
+            vec![0, 1, 2]
+        );
+        assert_eq!(events.len(), 1);
+        assert_eq!(events[0].channel_idx, 3);
+    }
 }
 
