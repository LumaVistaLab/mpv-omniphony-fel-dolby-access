+impl ChannelState {
+    pub(super) fn set_gain_db(&mut self, gain_db: i8, ramp_length: u64) {
+        if self.gain_db == gain_db {
+            return;
+        }
+        self.gain_db = gain_db;
+        let target = if gain_db == -128 {
+            0.0
+        } else {
+            10.0_f32.powf(gain_db as f32 / 20.0)
+        };
+        if ramp_length == 0 || (target - self.gain_current_linear).abs() <= f32::EPSILON {
+            self.gain_start_linear = target;
+            self.gain_current_linear = target;
+            self.gain_target_linear = target;
+            self.gain_ramp_length = 0;
+            self.gain_ramp_remaining = 0;
+        } else {
+            self.gain_start_linear = self.gain_current_linear;
+            self.gain_target_linear = target;
+            self.gain_ramp_length = ramp_length;
+            self.gain_ramp_remaining = ramp_length;
+        }
+    }
+
+    /// Write and advance a sample-accurate linear-amplitude gain ramp. Linear
+    /// amplitude interpolation also gives finite fades to and from the OAMD
+    /// negative-infinity gain code.
+    pub(super) fn write_gain_envelope(
+        &mut self,
+        output: &mut Vec<f32>,
+        sample_length: usize,
+        multiplier: f32,
+    ) {
+        output.clear();
+        output.resize(sample_length, 0.0);
+        for gain in output {
+            if self.gain_ramp_remaining > 0 {
+                let completed = self.gain_ramp_length - self.gain_ramp_remaining + 1;
+                let progress = completed as f32 / self.gain_ramp_length as f32;
+                self.gain_current_linear = self.gain_start_linear
+                    + (self.gain_target_linear - self.gain_start_linear) * progress;
+                self.gain_ramp_remaining -= 1;
+                if self.gain_ramp_remaining == 0 {
+                    self.gain_current_linear = self.gain_target_linear;
+                }
+            } else {
+                self.gain_current_linear = self.gain_target_linear;
+            }
+            *gain = self.gain_current_linear * multiplier;
+        }
+    }
+}
