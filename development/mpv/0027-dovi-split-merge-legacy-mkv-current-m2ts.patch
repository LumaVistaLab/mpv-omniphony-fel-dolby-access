+static int hevc_nal_length_size(const AVCodecParameters *par)
+{
+    const uint8_t *ed = par ? par->extradata : NULL;
+    int ed_size = par ? par->extradata_size : 0;
+
+    // Match the original FFmpeg 8 splitter: hvcC starts with
+    // configurationVersion=1 and stores lengthSizeMinusOne in byte 21.
+    if (ed_size >= 23 && ed[0] == 1 &&
+        AV_RB24(ed) != 1 && AV_RB32(ed) != 1)
+        return (ed[21] & 3) + 1;
+    return 0;
+}
+
+static size_t read_nal_size(const uint8_t *data, int length_size)
+{
+    size_t size = 0;
+    for (int i = 0; i < length_size; i++)
+        size = (size << 8) | data[i];
+    return size;
+}
+
+static size_t find_start_code(const uint8_t *data, size_t size, size_t offset,
+                              size_t *prefix_size)
+{
+    for (size_t i = offset; i + 3 <= size; i++) {
+        if (data[i] != 0 || data[i + 1] != 0)
+            continue;
+        if (data[i + 2] == 1) {
+            *prefix_size = 3;
+            return i;
+        }
+        if (i + 4 <= size && data[i + 2] == 0 && data[i + 3] == 1) {
+            *prefix_size = 4;
+            return i;
+        }
+    }
+    return size;
+}
+
+static bool next_hevc_nal(const struct mp_dovi_split *s,
+                          const uint8_t *data, size_t size, size_t *offset,
+                          const uint8_t **nal, size_t *nal_size)
+{
+    if (*offset >= size)
+        return false;
+
+    if (s->nal_length_size) {
+        size_t remaining = size - *offset;
+        if (remaining < s->nal_length_size)
+            return false;
+        size_t length = read_nal_size(data + *offset, s->nal_length_size);
+        *offset += s->nal_length_size;
+        if (length > size - *offset) {
+            *offset = size;
+            return false;
+        }
+        *nal = data + *offset;
+        *nal_size = length;
+        *offset += length;
+        return true;
+    }
+
+    size_t prefix_size = 0;
+    size_t start = find_start_code(data, size, *offset, &prefix_size);
+    if (start == size) {
+        *offset = size;
+        return false;
+    }
+    start += prefix_size;
+
+    size_t next_prefix_size = 0;
+    size_t end = find_start_code(data, size, start, &next_prefix_size);
+    *offset = end;
+    while (end > start && data[end - 1] == 0)
+        end--;
+    *nal = data + start;
+    *nal_size = end - start;
+    return true;
+}
