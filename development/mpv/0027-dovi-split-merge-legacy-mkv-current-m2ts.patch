+static struct demux_packet *split_legacy_mkv_packet(struct mp_dovi_split *s,
+                                                    struct demux_packet *bl_dp)
+{
+    const uint8_t *data = bl_dp->buffer;
+    size_t size = bl_dp->len;
+    size_t offset = 0;
+    size_t output_size = 0;
+    const uint8_t *nal = NULL;
+    size_t nal_size = 0;
+
+    // This is the byte-level behavior of the original FFmpeg 8 dovi_split:
+    // retain NAL type 63 only, remove its two-byte outer HEVC header, and
+    // prefix the embedded enhancement-layer NAL with an Annex-B start code.
+    while (next_hevc_nal(s, data, size, &offset, &nal, &nal_size)) {
+        int nal_type = nal_size ? (nal[0] >> 1) & 0x3f : -1;
+        if (nal_type != 63 || nal_size <= 2)
+            continue;
+        size_t payload_size = nal_size - 2;
+        if (output_size > SIZE_MAX - 4 ||
+            payload_size > SIZE_MAX - output_size - 4)
+            return NULL;
+        output_size += 4 + payload_size;
+    }
+
+    if (!output_size)
+        return NULL;
+
+    struct demux_packet *dp =
+        new_demux_packet(s->demuxer->packet_pool, output_size);
+    if (!dp)
+        return NULL;
+
+    uint8_t *dst = dp->buffer;
+    offset = 0;
+    while (next_hevc_nal(s, data, size, &offset, &nal, &nal_size)) {
+        int nal_type = nal_size ? (nal[0] >> 1) & 0x3f : -1;
+        if (nal_type != 63 || nal_size <= 2)
+            continue;
+        size_t payload_size = nal_size - 2;
+        AV_WB32(dst, 1);
+        dst += 4;
+        memcpy(dst, nal + 2, payload_size);
+        dst += payload_size;
+    }
+
+    demux_packet_copy_attribs(dp, bl_dp);
+    dp->stream = s->el->index;
+    return dp;
+}
