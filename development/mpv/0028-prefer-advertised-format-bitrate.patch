diff --git a/demux/demux.c b/demux/demux.c
index 4e89a62905..2419cc7c91 100644
--- a/demux/demux.c
+++ b/demux/demux.c
@@ -1288,10 +1288,12 @@ void demux_append_codec_desc(void *ta_ctx, bstr *dst, struct sh_stream *sh,
     if (c->samplerate)
         bstr_xappend_asprintf(ta_ctx, dst, " %d Hz", c->samplerate);
     int bitrate = 0;
-    if (c->bitrate > 0 && c->bitrate < INT_MAX - 500) {
-        bitrate = (c->bitrate + 500) / 1000;
-    } else if (sh->hls_bitrate > 0 && sh->hls_bitrate < INT_MAX - 500) {
+    // A manifest/EDL rate describes the format; a probe may cover only a
+    // small initial fragment. Keep edition and track descriptions consistent.
+    if (sh->hls_bitrate > 0 && sh->hls_bitrate < INT_MAX - 500) {
         bitrate = (sh->hls_bitrate + 500) / 1000;
+    } else if (c->bitrate > 0 && c->bitrate < INT_MAX - 500) {
+        bitrate = (c->bitrate + 500) / 1000;
     }
     if (bitrate)
         append_field(ta_ctx, dst, skip_dup, mp_tprintf(32, "%d kbps", bitrate));
