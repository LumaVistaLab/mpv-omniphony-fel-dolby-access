+
+// Optional finite floating-point parameter.
+static double get_param_double(struct parse_ctx *ctx, const char *name, double def)
+{
+    bstr val = get_param(ctx, name);
+    if (val.start) {
+        bstr rest;
+        double num = bstrtod(val, &rest);
+        if (!val.len || rest.len || !isfinite(num)) {
+            MP_ERR(ctx, "Invalid number for %s: '%.*s'\n", name, BSTR_P(val));
+            ctx->error = true;
+            return def;
+        }
+        return num;
     }
     return def;
 }
